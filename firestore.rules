rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Students Collection (Allows students to register accounts & admin to manage them)
    match /students/{studentId} {
      allow read, write: if true;
    }
    
    // Batches Collection
    match /batches/{batchId} {
      allow read, write: if true;
    }
    
    // Fee Records Collection
    match /feeRecords/{recordId} {
      allow read, write: if true;
    }
    
    // Notes Collection
    match /notes/{noteId} {
      allow read, write: if true;
    }
    
    // Note Files (Chunks) Collection
    match /fileChunks/{fileId} {
      allow read, write: if true;
      
      match /chunks/{chunkId} {
        allow read, write: if true;
      }
    }

    match /note_files/{fileId} {
      allow read, write: if true;
      
      match /chunks/{chunkId} {
        allow read, write: if true;
      }
    }
    
    // Doubts Collection
    match /doubts/{doubtId} {
      allow read, write: if true;
    }
    
    // Tests Collection
    match /tests/{testId} {
      allow read, write: if true;
    }
    
    // Notifications Collection
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // FCM Push Tokens
    match /pushTokens/{token} {
      allow read, write: if true;
    }

    // FCM Push Queue
    match /pushQueue/{notifId} {
      allow read, write: if true;
    }

    // Site Settings Collection (logo, name, tagline, deleted student IDs)
    match /siteSettings/{docId} {
      allow read, write: if true;
    }

    // Support Requests Collection
    match /supportRequests/{requestId} {
      allow read, write: if true;
    }

    // Announcements Collection
    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    // Live Meetings Collection
    match /liveMeetings/{meetingId} {
      allow read, write: if true;
      
      // Allow recursive access to subcollections (participants, signals)
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }
  }
}
